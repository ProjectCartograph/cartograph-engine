{
  "$id": "operation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "cartograph/v1"
    },
    "kind": {
      "const": "Operation"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/Metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "team"
      ],
      "properties": {
        "name": {
          "description": "Deprecated: the name is metadata.name, as Kubernetes keeps it. Read from a manifest saved before 2.6.0 and folded into metadata.name; never written.",
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "running",
            "retired"
          ],
          "description": "Where the service is in its life (ITIL's service portfolio: pipeline, live, retired; TAXONOMY.md D30). planned: decided on and being set up, not yet run, so the project that sets it up can name it before it exists. running: in use; a service without a status is running, as every operation saved before 2.7 was. retired: no longer offered, kept so the work that named it still reads."
        },
        "serviceOwner": {
          "$ref": "common.schema.json#/$defs/Slug",
          "x-cartograph-ref": "Resource",
          "description": "The role accountable for the service end to end (ITIL 4 service owner). A role from the Resource catalogue; team is the unit that runs it."
        },
        "team": {
          "$ref": "common.schema.json#/$defs/Slug",
          "x-cartograph-ref": "Team"
        },
        "programmes": {
          "type": "array",
          "description": "The programmes this operation is part of. Both programme standards put business-as-usual inside the programme boundary, so a programme that could only name projects would answer \"what is in this programme?\" with half the work (TAXONOMY.md D2). Declared here and read back on the programme, the same way a project declares its own.",
          "items": {
            "$ref": "common.schema.json#/$defs/Slug",
            "x-cartograph-ref": "Programme"
          }
        },
        "serviceWindow": {
          "type": "string"
        },
        "kpis": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Slug",
            "x-cartograph-ref": "KPI"
          }
        },
        "data": {
          "$ref": "common.schema.json#/$defs/DataUse"
        },
        "mandate": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/Mandate"
          }
        },
        "funding": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "currency",
              "status",
              "per"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0,
                "description": "What it costs to run the service for one period (per)."
              },
              "currency": {
                "type": "string",
                "enum": [
                  "AED",
                  "AFN",
                  "ALL",
                  "AMD",
                  "ANG",
                  "AOA",
                  "ARS",
                  "AUD",
                  "AWG",
                  "AZN",
                  "BAM",
                  "BBD",
                  "BDT",
                  "BHD",
                  "BIF",
                  "BMD",
                  "BND",
                  "BOB",
                  "BOV",
                  "BRL",
                  "BSD",
                  "BTN",
                  "BWP",
                  "BYN",
                  "BZD",
                  "CAD",
                  "CDF",
                  "CHE",
                  "CHF",
                  "CHW",
                  "CLF",
                  "CLP",
                  "CNY",
                  "COP",
                  "COU",
                  "CRC",
                  "CUP",
                  "CVE",
                  "CZK",
                  "DJF",
                  "DKK",
                  "DOP",
                  "DZD",
                  "EGP",
                  "ERN",
                  "ETB",
                  "EUR",
                  "FJD",
                  "FKP",
                  "GBP",
                  "GEL",
                  "GHS",
                  "GIP",
                  "GMD",
                  "GTQ",
                  "GYD",
                  "HKD",
                  "HNL",
                  "HTG",
                  "HUF",
                  "IDR",
                  "ILS",
                  "INR",
                  "IQD",
                  "IRR",
                  "ISK",
                  "JMD",
                  "JOD",
                  "JPY",
                  "KES",
                  "KGS",
                  "KHR",
                  "KMF",
                  "KPW",
                  "KRW",
                  "KWD",
                  "KYD",
                  "KZT",
                  "LAK",
                  "LBP",
                  "LRD",
                  "LSL",
                  "LYD",
                  "MAD",
                  "MDL",
                  "MGA",
                  "MKD",
                  "MMK",
                  "MNT",
                  "MOP",
                  "MRU",
                  "MUR",
                  "MVR",
                  "MWK",
                  "MXN",
                  "MXV",
                  "MYR",
                  "MZN",
                  "NAD",
                  "NPR",
                  "NZD",
                  "OMR",
                  "PAB",
                  "PEN",
                  "PHP",
                  "PKR",
                  "PLN",
                  "PYG",
                  "QAR",
                  "RON",
                  "RSD",
                  "RUB",
                  "RWF",
                  "SAR",
                  "SBD",
                  "SCR",
                  "SDG",
                  "SEK",
                  "SGD",
                  "SHP",
                  "SLE",
                  "SOS",
                  "SRD",
                  "SSP",
                  "STN",
                  "SYP",
                  "SZL",
                  "THB",
                  "TJS",
                  "TMT",
                  "TND",
                  "TOP",
                  "TRY",
                  "TTD",
                  "TWD",
                  "TZS",
                  "UAH",
                  "UGX",
                  "USD",
                  "USN",
                  "UYI",
                  "UYU",
                  "UYW",
                  "UZS",
                  "VED",
                  "VES",
                  "VND",
                  "VUV",
                  "WST",
                  "XAF",
                  "XAG",
                  "XAU",
                  "XBA",
                  "XBB",
                  "XBC",
                  "XBD",
                  "XCD",
                  "XDR",
                  "XOF",
                  "XPD",
                  "XPF",
                  "XPT",
                  "XSU",
                  "XTS",
                  "XUA",
                  "XXX",
                  "YER",
                  "ZAR",
                  "ZMW",
                  "ZWG"
                ],
                "description": "The currency this line is drawn in, from the active ISO 4217 list. A picker rather than three typed letters: a currency is an identifier from a published standard, and a field that accepts any three capitals accepts a typo."
              },
              "source": {
                "$ref": "common.schema.json#/$defs/Slug",
                "x-cartograph-ref": "FundingSource",
                "description": "The budget this line draws on, by reference. Optional, because a running cost nobody has found a budget for yet is a real state and a service should be able to say so."
              },
              "status": {
                "type": "string",
                "enum": [
                  "approved",
                  "requested",
                  "unfunded"
                ]
              },
              "per": {
                "type": "string",
                "enum": [
                  "month",
                  "year"
                ],
                "description": "The period the amount is for. A service's cost recurs for as long as it runs, so a line without a period would read as a one-off total."
              }
            }
          },
          "description": "The budgets that pay to run this service, each with the amount per month or per year (TAXONOMY.md D39). A service's running cost starts after the project that sets it up has closed, so it lives here, not on the project's funding lines. At most one line per currency and period (a kind rule)."
        },
        "notes": {
          "type": "object",
          "description": "A note per step of the walk, keyed by the step's own name. One map rather than a property per step, because a note is the same thing wherever it is written and a schema that names every step has to be edited whenever the walk changes. What belongs here is what the fields above cannot hold and nobody should have to hold in their head: a caveat, a reason a choice was made, something to come back to. Not a substitute for a field: anything Cartograph can hold in a shape belongs in that shape, where it can be checked, rolled up and read back.",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          },
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/Slug"
          }
        }
      }
    }
  }
}
