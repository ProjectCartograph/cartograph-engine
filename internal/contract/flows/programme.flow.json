{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "programme",
    "name": "Programme"
  },
  "spec": {
    "for": "Programme",
    "steps": [
      {
        "key": "aim",
        "title": "Aim",
        "guide": "The change this programme makes, and who gains from it.",
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/aim/change",
            "control": "sentence",
            "title": "Intended change",
            "hint": "How things will be after the change."
          },
          {
            "path": "/spec/aim/gain",
            "control": "sentence",
            "title": "Benefit",
            "hint": "What the people who gain will be able to do that they cannot do now."
          },
          {
            "path": "/spec/source",
            "control": "text"
          }
        ]
      },
      {
        "key": "problems",
        "title": "Problems",
        "guide": "What is going wrong now, for whom, and the evidence for it.",
        "fields": [
          {
            "path": "/spec/problems",
            "control": "list",
            "key": "id",
            "checks": [
              "problems-stated"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/groups",
                "control": "references",
                "checks": [
                  "problems-groups"
                ]
              },
              {
                "path": "/problem/situation",
                "control": "sentence"
              },
              {
                "path": "/problem/cause",
                "control": "sentence"
              },
              {
                "path": "/change/what",
                "control": "sentence"
              },
              {
                "path": "/change/gain",
                "control": "sentence"
              },
              {
                "path": "/gaps",
                "control": "list",
                "key": "gap",
                "checks": [
                  "problems-gaps"
                ],
                "fields": [
                  {
                    "path": "/gap",
                    "control": "reference"
                  },
                  {
                    "path": "/segments",
                    "control": "references"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "key": "alignment",
        "title": "Alignment",
        "guide": "The outcomes the programme serves, and the indicators it is judged by.",
        "fields": [
          {
            "path": "/spec/goals",
            "control": "references",
            "title": "Outcomes",
            "checks": [
              "alignment-goals"
            ]
          },
          {
            "path": "/spec/kpis",
            "control": "references",
            "title": "Indicators",
            "checks": [
              "alignment-kpis"
            ]
          },
          {
            "path": "/spec/programmes",
            "control": "references",
            "title": "Part of programmes"
          },
          {
            "path": "/spec/portfolios",
            "control": "references",
            "title": "Portfolios"
          }
        ],
        "phase": "align"
      },
      {
        "key": "components",
        "title": "Components",
        "guide": "The projects, smaller programmes and services this programme coordinates.",
        "fields": [
          {
            "path": "/spec/components",
            "control": "list",
            "key": "id",
            "hint": "The projects and programmes this one depends on. Add one only if this work cannot finish without it.",
            "checks": [
              "components-loop"
            ],
            "fields": [
              {
                "path": "/kind",
                "control": "choice"
              },
              {
                "path": "/id",
                "control": "reference"
              },
              {
                "path": "/why",
                "control": "sentence",
                "hint": "What this work needs from it."
              }
            ]
          }
        ],
        "links": [
          {
            "kind": "Project",
            "path": "/spec/alignment/programmes",
            "check": "components-present",
            "phase": "align"
          },
          {
            "kind": "Programme",
            "path": "/spec/programmes",
            "check": "components-present",
            "phase": "align"
          },
          {
            "kind": "Operation",
            "path": "/spec/programmes",
            "check": "components-present",
            "phase": "align"
          }
        ]
      },
      {
        "key": "pathway",
        "title": "How the change happens",
        "guide": "How the change is expected to happen: each outcome, what must be true first, and why.",
        "fields": [
          {
            "path": "/spec/pathway",
            "control": "list",
            "key": "id",
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/outcome",
                "control": "reference"
              },
              {
                "path": "/from",
                "control": "references"
              },
              {
                "path": "/because",
                "control": "sentence"
              },
              {
                "path": "/assumes",
                "control": "references"
              }
            ]
          }
        ]
      },
      {
        "key": "risks",
        "title": "Risks",
        "guide": "What could stop the change at programme level, and what the programme waits on.",
        "optional": true,
        "fields": [
          {
            "path": "/spec/risks",
            "control": "list",
            "key": "id",
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/type",
                "control": "choice"
              },
              {
                "path": "/description",
                "control": "sentence"
              },
              {
                "path": "/impact",
                "control": "choice"
              },
              {
                "path": "/likelihood",
                "control": "choice"
              },
              {
                "path": "/mitigation",
                "control": "sentence",
                "checks": [
                  "risks-mitigation"
                ]
              },
              {
                "path": "/owner",
                "control": "reference",
                "title": "Owned by",
                "hint": "The role that manages it day to day.",
                "checks": [
                  "risks-owned"
                ]
              },
              {
                "path": "/depends/direction",
                "control": "choice"
              },
              {
                "path": "/depends/on",
                "control": "reference",
                "checks": [
                  "risks-dependency-edges",
                  "risks-dependency-cycle"
                ]
              },
              {
                "path": "/escalate/flag",
                "control": "toggle"
              },
              {
                "path": "/escalate/reason",
                "control": "sentence"
              },
              {
                "path": "/escalate/to",
                "control": "reference"
              }
            ]
          }
        ]
      },
      {
        "key": "governance",
        "title": "Governance",
        "guide": "The roles accountable for the programme, the teams that run it, and the mandate it works under.",
        "fields": [
          {
            "path": "/spec/sponsor",
            "control": "reference",
            "title": "Sponsor"
          },
          {
            "path": "/spec/manager",
            "control": "reference",
            "title": "Programme manager"
          },
          {
            "path": "/spec/businessChangeManager",
            "control": "reference",
            "title": "Business change manager"
          },
          {
            "path": "/spec/leadTeam",
            "control": "reference",
            "title": "Lead team"
          },
          {
            "path": "/spec/supportingTeams",
            "control": "references",
            "title": "Supporting teams"
          },
          {
            "path": "/spec/mandate",
            "control": "list",
            "key": "title",
            "fields": [
              {
                "path": "/kind",
                "control": "choice"
              },
              {
                "path": "/title",
                "control": "text"
              },
              {
                "path": "/reference",
                "control": "text"
              },
              {
                "path": "/date",
                "control": "date"
              },
              {
                "path": "/issuer",
                "control": "reference",
                "title": "Issued by",
                "hint": "A board, committee or role already in Cartograph."
              },
              {
                "path": "/issuedBy",
                "control": "text",
                "title": "Or someone not in Cartograph",
                "hint": "An organisation not listed in Cartograph, such as a regulator."
              }
            ]
          },
          {
            "path": "/spec/escalationRoute",
            "control": "references",
            "title": "Escalation route",
            "hint": "Who decides when it cannot be decided here, closest first."
          },
          {
            "path": "/spec/notes",
            "control": "sentence"
          }
        ]
      }
    ],
    "prepare": [
      {
        "kind": "Team",
        "needed": true,
        "guide": "The team that leads the programme, and those that support it."
      },
      {
        "kind": "Resource",
        "needed": true,
        "guide": "The roles accountable for it: its sponsor, its manager and who leads the change."
      },
      {
        "kind": "Goal",
        "level": "outcome",
        "needed": true,
        "guide": "The outcomes it aims for, and the steps that lead to them."
      },
      {
        "kind": "Segment",
        "needed": false,
        "guide": "The places or groups where its problems show up, such as a region."
      },
      {
        "kind": "BeneficiaryGroup",
        "needed": false,
        "guide": "Who its problems affect."
      },
      {
        "kind": "KPI",
        "needed": false,
        "guide": "The indicators it is judged by."
      },
      {
        "kind": "Gap",
        "needed": false,
        "guide": "The gaps behind its problems."
      },
      {
        "kind": "Assumption",
        "needed": false,
        "guide": "What it assumes to be true but has not proved."
      },
      {
        "kind": "Portfolio",
        "needed": false,
        "guide": "The portfolios that fund it, if any."
      }
    ],
    "review": true
  }
}
