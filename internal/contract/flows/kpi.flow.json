{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "kpi",
    "name": "KPI"
  },
  "spec": {
    "for": "KPI",
    "steps": [
      {
        "key": "definition",
        "title": "Definition",
        "guide": "What is counted, in what unit, and which way is good.",
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/definition",
            "control": "sentence",
            "hint": "Exactly what gets counted."
          },
          {
            "path": "/spec/unit",
            "control": "reference",
            "hint": "What it is counted in. Pick one, or add a new one if nothing fits."
          },
          {
            "path": "/spec/direction",
            "control": "choice"
          }
        ]
      },
      {
        "key": "result",
        "title": "Result",
        "guide": "The aims this KPI measures progress on.",
        "fields": [
          {
            "path": "/spec/goals",
            "control": "references",
            "hint": "The aims this KPI measures progress on.",
            "checks": [
              "kpi-aligned"
            ]
          },
          {
            "path": "/spec/resultLevel",
            "control": "choice"
          }
        ],
        "links": [
          {
            "kind": "Gap",
            "path": "/spec/measure",
            "check": "gap-measured",
            "needs": "holder",
            "phase": "align"
          }
        ],
        "phase": "align"
      },
      {
        "key": "baseline-target",
        "title": "Baseline and target",
        "guide": "The value today and the value to reach, each with its month.",
        "fields": [
          {
            "path": "/spec/baseline/value",
            "control": "number",
            "hint": "The value today.",
            "checks": [
              "kpi-baseline"
            ]
          },
          {
            "path": "/spec/baseline/date",
            "control": "date",
            "hint": "The month that figure is from."
          },
          {
            "path": "/spec/baseline/unknownReason",
            "control": "sentence",
            "hint": "If today's figure is not known, why, and when it will be.",
            "checks": [
              "kpi-baseline"
            ]
          },
          {
            "path": "/spec/baseline/expectedBy",
            "control": "date"
          },
          {
            "path": "/spec/target/value",
            "control": "number",
            "hint": "Where it needs to get to.",
            "checks": [
              "kpi-target"
            ]
          },
          {
            "path": "/spec/target/date",
            "control": "date",
            "hint": "The month it is due by."
          }
        ],
        "phase": "measure"
      },
      {
        "key": "verification",
        "title": "How to check",
        "guide": "Where the number is read from, and how often.",
        "fields": [
          {
            "path": "/spec/sources",
            "control": "reference",
            "hint": "The system or record this number comes from."
          },
          {
            "path": "/spec/cycle",
            "control": "reference",
            "hint": "How often it is read, which sets the periods you record readings for.",
            "checks": [
              "kpi-cycle"
            ]
          },
          {
            "path": "/spec/owner",
            "control": "reference",
            "title": "Owned by",
            "hint": "The role responsible for this KPI."
          }
        ],
        "links": [
          {
            "kind": "KPIReadings",
            "path": "/spec/kpi"
          }
        ],
        "phase": "measure"
      },
      {
        "key": "disaggregation",
        "title": "Breakdown",
        "guide": "How this number is split, such as by region, if at all.",
        "optional": true,
        "fields": [
          {
            "path": "/spec/disaggregations",
            "control": "references",
            "hint": "How this number is broken down, such as by region. Leave empty if only the total is reported."
          }
        ]
      },
      {
        "key": "metric",
        "title": "How it is computed",
        "guide": "How the number is computed from its sources, in the terms of the dbt semantic layer, so an analytics engineer can build it as a dbt metric.",
        "optional": true,
        "phase": "measure",
        "fields": [
          {
            "path": "/spec/metric/type",
            "control": "choice",
            "hint": "Simple: one count or sum. Ratio: one count out of another. Cumulative: a count summed over a window. Derived: worked out from other KPIs."
          },
          {
            "path": "/spec/metric/measure/source",
            "control": "reference",
            "hint": "What is counted: the data source it is counted in, one of this KPI's sources.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "simple",
                "cumulative"
              ]
            }
          },
          {
            "path": "/spec/metric/measure/agg",
            "control": "choice",
            "hint": "What is counted: how the rows are added up.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "simple",
                "cumulative"
              ]
            }
          },
          {
            "path": "/spec/metric/measure/expr",
            "control": "text",
            "hint": "What is counted: the column, or expression, added up. Leave it empty to count rows.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "simple",
                "cumulative"
              ]
            }
          },
          {
            "path": "/spec/metric/numerator/source",
            "control": "reference",
            "hint": "What is counted: the data source it is counted in, one of this KPI's sources.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "ratio"
              ]
            }
          },
          {
            "path": "/spec/metric/numerator/agg",
            "control": "choice",
            "hint": "What is counted: how the rows are added up.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "ratio"
              ]
            }
          },
          {
            "path": "/spec/metric/numerator/expr",
            "control": "text",
            "hint": "What is counted: the column, or expression, added up. Leave it empty to count rows.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "ratio"
              ]
            }
          },
          {
            "path": "/spec/metric/denominator/source",
            "control": "reference",
            "hint": "Out of what: the data source it is counted in, one of this KPI's sources.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "ratio"
              ]
            }
          },
          {
            "path": "/spec/metric/denominator/agg",
            "control": "choice",
            "hint": "Out of what: how the rows are added up.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "ratio"
              ]
            }
          },
          {
            "path": "/spec/metric/denominator/expr",
            "control": "text",
            "hint": "Out of what: the column, or expression, added up. Leave it empty to count rows.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "ratio"
              ]
            }
          },
          {
            "path": "/spec/metric/window",
            "control": "text",
            "hint": "How far back it sums, such as 28 days. Leave it empty to sum over all time.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "cumulative"
              ]
            }
          },
          {
            "path": "/spec/metric/uses",
            "control": "references",
            "hint": "The KPIs it is worked out from.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "derived"
              ]
            }
          },
          {
            "path": "/spec/metric/expr",
            "control": "text",
            "hint": "The expression over them, each named by its id with hyphens as underscores.",
            "when": {
              "path": "/spec/metric/type",
              "in": [
                "derived"
              ]
            }
          },
          {
            "path": "/spec/metric/filter",
            "control": "text",
            "hint": "Only the rows it counts, as a dbt filter. Leave it empty to count every row."
          }
        ]
      },
      {
        "key": "control",
        "title": "Holding the gain",
        "optional": true,
        "phase": "measure",
        "guide": "The values a reading must stay within, and what is done when one does not, so the gain is held once the work is done.",
        "fields": [
          {
            "path": "/spec/specLimits/lower",
            "control": "number",
            "hint": "The lowest value that still meets the requirement. Leave it empty if there is no floor."
          },
          {
            "path": "/spec/specLimits/upper",
            "control": "number",
            "hint": "The highest value that still meets the requirement. Leave it empty if there is no ceiling."
          },
          {
            "path": "/spec/response/trigger",
            "control": "sentence",
            "hint": "What sets the response off: a reading outside the limits, a run of readings on one side, a trend."
          },
          {
            "path": "/spec/response/action",
            "control": "sentence",
            "hint": "What is done first."
          },
          {
            "path": "/spec/response/by",
            "control": "reference",
            "hint": "The role that acts."
          },
          {
            "path": "/spec/response/withinDays",
            "control": "number",
            "hint": "How many days it has to act."
          }
        ]
      }
    ],
    "review": true
  }
}
