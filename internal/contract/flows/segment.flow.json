{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "segment",
    "name": "Segment"
  },
  "spec": {
    "for": "Segment",
    "steps": [
      {
        "key": "definition",
        "title": "Definition",
        "guide": "A way of splitting numbers, such as by region, or one part of it, such as the north: its name and what it includes.",
        "fields": [
          {
            "path": "/spec/parent",
            "control": "reference",
            "hint": "The wider grouping this belongs to, such as Region for North. Leave empty if this is itself a grouping."
          },
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/description",
            "control": "sentence",
            "hint": "What belongs in this and what does not."
          }
        ],
        "links": [
          {
            "kind": "Gap",
            "path": "/spec/segments",
            "check": "gap-segments",
            "needs": "holder",
            "phase": "align"
          },
          {
            "kind": "KPI",
            "path": "/spec/disaggregations"
          }
        ]
      }
    ],
    "review": true
  }
}
