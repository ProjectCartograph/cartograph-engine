{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "kpireadings",
    "name": "KPI readings"
  },
  "spec": {
    "for": "KPIReadings",
    "steps": [
      {
        "key": "indicator",
        "title": "Indicator",
        "guide": "The KPI these readings are for. Its unit and reporting cycle come from the KPI.",
        "fields": [
          {
            "path": "/spec/kpi",
            "control": "reference"
          },
          {
            "path": "/metadata/name",
            "control": "text"
          }
        ]
      },
      {
        "key": "actuals",
        "title": "Readings",
        "guide": "The value measured in each period so far.",
        "fields": [
          {
            "path": "/spec/readings",
            "control": "list",
            "key": "period",
            "hint": "Add a reading for each period you have measured. Leave out any period not measured yet.",
            "fields": [
              {
                "path": "/period",
                "control": "date",
                "hint": "The month the period ends."
              },
              {
                "path": "/value",
                "control": "number"
              },
              {
                "path": "/provisional",
                "control": "toggle"
              },
              {
                "path": "/note",
                "control": "sentence"
              }
            ]
          }
        ]
      }
    ],
    "review": true
  }
}
