{
  "$id": "team.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Team",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "cartograph/v1" },
    "kind": { "const": "Team" },
    "metadata": { "$ref": "common.schema.json#/$defs/Metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "name": { "description": "Deprecated: the name is metadata.name, as Kubernetes keeps it. Read from a manifest saved before 2.6.0 and folded into metadata.name; never written.", "type": "string", "minLength": 1 },
        "parent": { "$ref": "common.schema.json#/$defs/Slug", "x-cartograph-ref": "Team" },
        "description": { "type": "string" }
      }
    }
  }
}
