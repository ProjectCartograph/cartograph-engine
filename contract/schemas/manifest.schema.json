{
  "$id": "manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "description": "The generic envelope shared by every kind. Kind-specific validation uses the schema at contract/schemas/<kind>.schema.json instead of this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "cartograph/v1" },
    "kind": {
      "type": "string",
      "enum": [
        "Team", "ReportingCycle", "DataSource", "BeneficiaryGroup", "Goal", "KPI",
        "Programme", "Operation", "Project", "Resource", "Settings"
      ]
    },
    "metadata": { "$ref": "common.schema.json#/$defs/Metadata" },
    "spec": { "type": "object" }
  }
}
