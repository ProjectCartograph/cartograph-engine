{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "purpose",
    "name": "Purpose"
  },
  "spec": {
    "for": "Purpose",
    "steps": [
      {
        "key": "purpose",
        "title": "Purpose",
        "guide": "Your organisation's vision and mission, which every goal serves.",
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/organisation",
            "control": "text",
            "title": "Organisation",
            "hint": "The name your organisation goes by.",
            "checks": [
              "purpose-organisation"
            ]
          },
          {
            "path": "/spec/logo",
            "control": "image",
            "title": "Logo",
            "hint": "Shown beside the name and on every charter's cover."
          },
          {
            "path": "/spec/vision",
            "control": "sentence",
            "title": "Vision",
            "hint": "The future the organisation is working towards.",
            "checks": [
              "purpose-vision"
            ]
          },
          {
            "path": "/spec/mission",
            "control": "sentence",
            "title": "Mission",
            "hint": "What the organisation does to get there.",
            "checks": [
              "purpose-mission"
            ]
          },
          {
            "path": "/spec/source",
            "control": "text",
            "title": "Source"
          }
        ]
      }
    ],
    "review": true
  }
}
