{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "resource",
    "name": "Resource"
  },
  "spec": {
    "for": "Resource",
    "steps": [
      {
        "key": "definition",
        "title": "Definition",
        "guide": "A role, team, outside party, system or facility the work can draw on. Name a role, not a person.",
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/category",
            "control": "choice",
            "hint": "What kind of resource this is."
          },
          {
            "path": "/spec/description",
            "control": "sentence",
            "hint": "What this resource does, or what it is needed for."
          }
        ]
      }
    ],
    "review": true
  }
}
