{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "fundingsource",
    "name": "Funding source"
  },
  "spec": {
    "for": "FundingSource",
    "steps": [
      {
        "key": "identity",
        "title": "Budget",
        "guide": "The budget's name and its code in the accounts.",
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/code",
            "control": "text"
          }
        ]
      },
      {
        "key": "holder",
        "title": "Holder and period",
        "guide": "Who controls the budget, and the period it covers.",
        "fields": [
          {
            "path": "/spec/heldBy",
            "control": "reference"
          },
          {
            "path": "/spec/period",
            "control": "text"
          }
        ]
      },
      {
        "key": "note",
        "title": "Note",
        "guide": "Anything else to know about this budget.",
        "optional": true,
        "fields": [
          {
            "path": "/spec/note",
            "control": "sentence"
          }
        ]
      }
    ],
    "review": true
  }
}
