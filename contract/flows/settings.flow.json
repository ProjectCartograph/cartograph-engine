{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "settings",
    "name": "Settings"
  },
  "spec": {
    "for": "Settings",
    "steps": [
      {
        "key": "terms",
        "title": "Level names",
        "guide": "The words this vault uses for the levels of the strategy and for a project, where they differ from the standard ones.",
        "optional": true,
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/goalLevels",
            "control": "list",
            "title": "Goal levels"
          },
          {
            "path": "/spec/projectLevelName",
            "control": "text",
            "title": "Project"
          }
        ]
      },
      {
        "key": "configuration",
        "title": "Configuration",
        "guide": "How this vault records versions and renders documents.",
        "optional": true,
        "fields": [
          {
            "path": "/spec/operator",
            "control": "text",
            "title": "Operator"
          },
          {
            "path": "/spec/chromium",
            "control": "text",
            "title": "Chromium path"
          }
        ]
      },
      {
        "key": "change-control",
        "title": "Change control",
        "guide": "How the record may change: whether every change goes through a change set, and what a change set needs before it is rolled in.",
        "optional": true,
        "fields": [
          {
            "path": "/spec/changeControl/changeSetsRequired",
            "control": "toggle",
            "title": "Every change in a change set"
          },
          {
            "path": "/spec/changeControl/rollIn/checksMet",
            "control": "toggle",
            "title": "Every check met before rolling in"
          },
          {
            "path": "/spec/changeControl/rollIn/nothingLeftOpen",
            "control": "toggle",
            "title": "Nothing left open before rolling in"
          },
          {
            "path": "/spec/changeControl/rollIn/secondReviewer",
            "control": "toggle",
            "title": "Rolled in by someone other than its author"
          }
        ]
      }
    ],
    "review": true
  }
}
