{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "settings",
    "name": "Settings"
  },
  "spec": {
    "for": "Settings",
    "steps": [
      {
        "key": "terms",
        "title": "Level names",
        "guide": "The words this vault uses for the levels of the strategy and for a project, where they differ from the standard ones.",
        "optional": true,
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/goalLevels",
            "control": "list",
            "title": "Goal levels"
          },
          {
            "path": "/spec/projectLevelName",
            "control": "text",
            "title": "Project"
          }
        ]
      },
      {
        "key": "configuration",
        "title": "Configuration",
        "guide": "How this vault records versions and renders documents.",
        "optional": true,
        "fields": [
          {
            "path": "/spec/operator",
            "control": "text",
            "title": "Operator"
          },
          {
            "path": "/spec/chromium",
            "control": "text",
            "title": "Chromium path"
          }
        ]
      }
    ],
    "review": true
  }
}
