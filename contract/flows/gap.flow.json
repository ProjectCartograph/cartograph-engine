{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "gap",
    "name": "Gap"
  },
  "spec": {
    "for": "Gap",
    "steps": [
      {
        "key": "shortfall",
        "title": "Shortfall",
        "guide": "Where things are now, where they should be, and the outcome that closes the gap.",
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text",
            "hint": "A few words naming the shortfall, such as Faults are found after dispatch.",
            "checks": [
              "gap-results"
            ]
          },
          {
            "path": "/spec/measure",
            "control": "reference",
            "hint": "If a KPI measures this, its baseline is where things are now and its target is where they should be.",
            "checks": [
              "gap-states",
              "gap-measured"
            ],
            "phase": "align"
          },
          {
            "path": "/spec/current",
            "control": "sentence",
            "hint": "Where things are now, in one sentence.",
            "checks": [
              "gap-states"
            ]
          },
          {
            "path": "/spec/desired",
            "control": "sentence",
            "hint": "Where things should be, in one sentence.",
            "checks": [
              "gap-states"
            ]
          },
          {
            "path": "/spec/affects",
            "control": "references",
            "hint": "The groups of people this shortfall falls on."
          },
          {
            "path": "/spec/outcomes",
            "control": "references",
            "hint": "The outcome that would be true once this gap is closed.",
            "checks": [
              "gap-outcome"
            ],
            "phase": "align"
          }
        ]
      },
      {
        "key": "scope",
        "title": "Scope",
        "guide": "Where the gap shows up, such as a region or product line, and who is working on each.",
        "fields": [
          {
            "path": "/spec/segments",
            "control": "references",
            "hint": "Each region, product line or other group the evidence covers.",
            "checks": [
              "gap-segments",
              "gap-covered"
            ]
          }
        ],
        "links": [
          {
            "kind": "Project",
            "path": "/spec/summary/problems/-/gaps/-/gap",
            "check": "gap-covered",
            "phase": "align"
          },
          {
            "kind": "Programme",
            "path": "/spec/problems/-/gaps/-/gap",
            "check": "gap-covered",
            "phase": "align"
          }
        ]
      },
      {
        "key": "evidence",
        "title": "Evidence",
        "guide": "Where the finding was written down, in the source's own words.",
        "fields": [
          {
            "path": "/spec/source",
            "control": "text",
            "hint": "The document and section where this is written.",
            "checks": [
              "gap-source"
            ]
          },
          {
            "path": "/spec/statement",
            "control": "sentence",
            "hint": "The finding in the source's own words."
          },
          {
            "path": "/spec/dataSources",
            "control": "reference",
            "hint": "The data sources that show this gap, if any."
          },
          {
            "path": "/spec/note",
            "control": "sentence"
          }
        ]
      }
    ],
    "review": true
  }
}
