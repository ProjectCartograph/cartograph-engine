{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "project",
    "name": "Project"
  },
  "spec": {
    "for": "Project",
    "steps": [
      {
        "key": "goals",
        "title": "Alignment",
        "guide": "What this project is part of, and which outcomes it serves.",
        "fields": [
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/summary/about",
            "control": "sentence"
          },
          {
            "path": "/spec/summary/idea",
            "control": "sentence"
          },
          {
            "path": "/spec/alignment/programmes",
            "control": "references",
            "hint": "The programmes this project belongs to. It can belong to more than one.",
            "checks": [
              "goals-programme-membership",
              "components-programmes"
            ]
          },
          {
            "path": "/spec/alignment/portfolios",
            "control": "references",
            "hint": "The portfolios that choose and fund this project, if any."
          },
          {
            "path": "/spec/alignment/partOf",
            "control": "reference",
            "hint": "The larger project this is part of. Choose one only if both share a sponsor and budget.",
            "checks": [
              "components-parent",
              "components-one-level"
            ]
          },
          {
            "path": "/spec/components",
            "control": "list",
            "key": "id",
            "hint": "The projects and programmes this one depends on. Add one only if this work cannot finish without it.",
            "checks": [
              "components-loop"
            ],
            "fields": [
              {
                "path": "/kind",
                "control": "choice"
              },
              {
                "path": "/id",
                "control": "reference"
              },
              {
                "path": "/why",
                "control": "sentence",
                "hint": "What this work needs from it."
              }
            ]
          },
          {
            "path": "/spec/alignment/goals",
            "control": "references",
            "checks": [
              "goals-aligned",
              "goals-functional-level"
            ]
          },
          {
            "path": "/spec/team",
            "control": "reference"
          },
          {
            "path": "/spec/classification",
            "control": "text",
            "hint": "The classification the charter carries, in your organisation's words."
          }
        ],
        "phase": "align"
      },
      {
        "key": "beneficiaries",
        "title": "Beneficiaries",
        "guide": "The groups that gain value from this project, directly or indirectly.",
        "fields": [
          {
            "path": "/spec/summary/beneficiaries",
            "control": "list",
            "key": "group",
            "checks": [
              "beneficiaries-named"
            ],
            "fields": [
              {
                "path": "/group",
                "control": "reference"
              }
            ]
          }
        ]
      },
      {
        "key": "aim",
        "title": "Problem",
        "guide": "What the affected groups cannot do now, and how things will be after the change.",
        "fields": [
          {
            "path": "/spec/summary/problems",
            "control": "list",
            "key": "id",
            "checks": [
              "aim-problem-change",
              "aim-problem-groups"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/groups",
                "control": "references",
                "title": "Affected groups"
              },
              {
                "path": "/problem/situation",
                "control": "sentence",
                "title": "Problem",
                "hint": "What is going wrong for the affected groups now."
              },
              {
                "path": "/problem/cause",
                "control": "sentence",
                "title": "Potential cause",
                "hint": "What you think lies behind the problem."
              },
              {
                "path": "/change/what",
                "control": "sentence",
                "title": "Intended change",
                "hint": "How things will be after the change."
              },
              {
                "path": "/change/gain",
                "control": "sentence",
                "title": "Benefit",
                "hint": "What the affected groups will be able to do that they cannot do now."
              },
              {
                "path": "/gaps",
                "control": "list",
                "key": "gap",
                "title": "Gaps",
                "fields": [
                  {
                    "path": "/gap",
                    "control": "reference"
                  },
                  {
                    "path": "/segments",
                    "control": "references",
                    "hint": "Leave empty if the project covers the whole gap."
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "key": "measures",
        "title": "Objectives",
        "guide": "The change this project makes and how, and the measures that show it happened.",
        "fields": [
          {
            "path": "/spec/objectives",
            "control": "list",
            "key": "id",
            "checks": [
              "goals-objective",
              "goals-key-results-count",
              "components-add-up"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/objective",
                "control": "sentence",
                "hint": "Pick a verb, then say what it changes and how. Leave numbers to the key results."
              },
              {
                "path": "/keyResults",
                "control": "list",
                "key": "id",
                "title": "Key results",
                "hint": "One to three results you can measure. More dilutes the objective's focus.",
                "fields": [
                  {
                    "path": "/id",
                    "control": "readonly"
                  },
                  {
                    "path": "/metric",
                    "control": "text"
                  },
                  {
                    "path": "/kind",
                    "control": "choice"
                  },
                  {
                    "path": "/unit",
                    "control": "text"
                  },
                  {
                    "path": "/direction",
                    "control": "choice"
                  },
                  {
                    "path": "/baseline",
                    "control": "number",
                    "checks": [
                      "goals-key-results-baseline"
                    ]
                  },
                  {
                    "path": "/target",
                    "control": "number",
                    "checks": [
                      "goals-key-results-target"
                    ]
                  },
                  {
                    "path": "/source",
                    "control": "reference",
                    "checks": [
                      "goals-key-results-source",
                      "data-capture-turnaround",
                      "data-capture-decided"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "path": "/spec/kpis",
            "control": "list",
            "key": "kpi",
            "title": "Indicators",
            "checks": [
              "measures-kpis"
            ],
            "fields": [
              {
                "path": "/kpi",
                "control": "reference"
              },
              {
                "path": "/reason",
                "control": "sentence",
                "title": "Rationale"
              }
            ]
          }
        ],
        "phase": "measure"
      },
      {
        "key": "resources",
        "title": "Resources",
        "guide": "The roles the project needs, the money it draws on, and the mandate it works under.",
        "fields": [
          {
            "path": "/spec/resources",
            "control": "list",
            "key": "id",
            "title": "Roles",
            "hint": "Name the role, not a person.",
            "checks": [
              "resources-sponsor-lead",
              "resources-mapped",
              "landing-owner",
              "components-one-sponsor"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/role",
                "control": "choice"
              },
              {
                "path": "/resource",
                "control": "reference"
              },
              {
                "path": "/note",
                "control": "text"
              }
            ]
          },
          {
            "path": "/spec/funding",
            "control": "list",
            "key": "currency",
            "title": "Approved funding",
            "hint": "An amount for each currency.",
            "checks": [
              "resources-funding",
              "components-one-sponsor"
            ],
            "fields": [
              {
                "path": "/amount",
                "control": "number"
              },
              {
                "path": "/currency",
                "control": "choice"
              },
              {
                "path": "/source",
                "control": "reference",
                "title": "Budget"
              },
              {
                "path": "/status",
                "control": "choice"
              }
            ]
          },
          {
            "path": "/spec/mandate",
            "control": "list",
            "key": "title",
            "title": "Mandate",
            "checks": [
              "aim-mandate"
            ],
            "fields": [
              {
                "path": "/kind",
                "control": "choice"
              },
              {
                "path": "/title",
                "control": "text"
              },
              {
                "path": "/reference",
                "control": "text"
              },
              {
                "path": "/date",
                "control": "date"
              },
              {
                "path": "/issuer",
                "control": "reference",
                "title": "Issued by",
                "hint": "A board, committee or role already in Cartograph."
              },
              {
                "path": "/issuedBy",
                "control": "text",
                "title": "Or someone not in Cartograph",
                "hint": "An organisation not listed in Cartograph, such as a regulator."
              }
            ]
          },
          {
            "path": "/spec/escalationRoute",
            "control": "references",
            "title": "Escalation route",
            "hint": "Who decides when it cannot be decided here, closest first."
          },
          {
            "path": "/spec/responsibilities",
            "control": "list",
            "key": "id",
            "hint": "Who does it, the one accountable, who is consulted and who is told.",
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/item",
                "control": "sentence",
                "title": "Decision or deliverable"
              },
              {
                "path": "/decision",
                "control": "toggle",
                "title": "A decision"
              },
              {
                "path": "/deliverable",
                "control": "choice",
                "title": "Deliverable"
              },
              {
                "path": "/responsible",
                "control": "references",
                "title": "Responsible"
              },
              {
                "path": "/accountable",
                "control": "reference",
                "title": "Accountable"
              },
              {
                "path": "/consulted",
                "control": "references",
                "title": "Consulted"
              },
              {
                "path": "/informed",
                "control": "references",
                "title": "Informed"
              }
            ]
          },
          {
            "path": "/spec/costs",
            "control": "list",
            "key": "id",
            "checks": [
              "costs-funded"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/category",
                "control": "text"
              },
              {
                "path": "/basis",
                "control": "sentence"
              },
              {
                "path": "/amount",
                "control": "number"
              },
              {
                "path": "/currency",
                "control": "text"
              },
              {
                "path": "/period",
                "control": "text"
              },
              {
                "path": "/source",
                "control": "reference"
              },
              {
                "path": "/status",
                "control": "choice"
              },
              {
                "path": "/recurrent",
                "control": "sentence"
              }
            ]
          },
          {
            "path": "/spec/procurement",
            "control": "list",
            "key": "id",
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/requirement",
                "control": "sentence"
              },
              {
                "path": "/value",
                "control": "number"
              },
              {
                "path": "/currency",
                "control": "text"
              },
              {
                "path": "/valueNote",
                "control": "text"
              },
              {
                "path": "/method",
                "control": "text"
              },
              {
                "path": "/leadTime",
                "control": "text"
              },
              {
                "path": "/requiredBy",
                "control": "timing"
              },
              {
                "path": "/owner",
                "control": "reference"
              }
            ]
          }
        ]
      },
      {
        "key": "stakeholders",
        "title": "Stakeholders",
        "guide": "Who can affect this project or is affected by it, and how much influence each has.",
        "fields": [],
        "links": [
          {
            "kind": "StakeholderMap",
            "path": "/spec/scope"
          }
        ]
      },
      {
        "key": "scope",
        "title": "Scope",
        "guide": "Where the work starts and stops.",
        "fields": [
          {
            "path": "/spec/summary/scopeIn",
            "control": "list",
            "title": "In scope",
            "hint": "What the project covers, one item each.",
            "checks": [
              "scope-in"
            ]
          },
          {
            "path": "/spec/summary/scopeOut",
            "control": "list",
            "title": "Out of scope",
            "hint": "What people might expect that this will not do."
          }
        ]
      },
      {
        "key": "deliverables",
        "title": "Deliverables",
        "guide": "What the project produces, and how each one is checked before it is accepted.",
        "fields": [
          {
            "path": "/spec/workstreams",
            "control": "list",
            "key": "id",
            "hint": "Group the deliverables under a lead role. A workstream that needs its own sponsor or budget is a component project.",
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/name",
                "control": "text"
              },
              {
                "path": "/purpose",
                "control": "sentence"
              },
              {
                "path": "/lead",
                "control": "reference",
                "title": "Lead"
              },
              {
                "path": "/supporting",
                "control": "references",
                "title": "Supported by"
              },
              {
                "path": "/dependsOn",
                "control": "sentence",
                "title": "Needs from outside"
              }
            ]
          },
          {
            "path": "/spec/deliverables",
            "control": "list",
            "key": "id",
            "checks": [
              "deliverables-count",
              "deliverables-acceptance",
              "deliverables-verifier",
              "closing-criteria",
              "deliverables-register"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/name",
                "control": "text"
              },
              {
                "path": "/description",
                "control": "sentence"
              },
              {
                "path": "/owner",
                "control": "reference",
                "title": "Owner"
              },
              {
                "path": "/due",
                "control": "timing",
                "title": "Due"
              },
              {
                "path": "/workstream",
                "control": "choice",
                "title": "Workstream"
              },
              {
                "path": "/evidence",
                "control": "sentence",
                "title": "Evidence"
              },
              {
                "path": "/acceptance",
                "control": "list",
                "title": "Accepted when",
                "hint": "Name a role, and what it confirms.",
                "fields": [
                  {
                    "path": "/by",
                    "control": "reference",
                    "title": "Verified by"
                  },
                  {
                    "path": "/outcome",
                    "control": "sentence",
                    "title": "Confirms that"
                  }
                ]
              },
              {
                "path": "/tasks",
                "control": "list",
                "key": "id",
                "title": "Tasks",
                "hint": "The work that produces it, in any order. No dates.",
                "fields": [
                  {
                    "path": "/id",
                    "control": "readonly"
                  },
                  {
                    "path": "/name",
                    "control": "text",
                    "title": "Task"
                  },
                  {
                    "path": "/role",
                    "control": "reference",
                    "title": "Done by"
                  },
                  {
                    "path": "/note",
                    "control": "sentence",
                    "title": "Note"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "key": "timeline",
        "title": "Schedule",
        "guide": "When the work starts and its phases. The end date is worked out from them.",
        "fields": [
          {
            "path": "/spec/milestones",
            "control": "list",
            "key": "id",
            "checks": [
              "milestones-timing",
              "milestones-loop"
            ],
            "hint": "Each milestone with when it falls: a date, a window, after another milestone, or when something happens.",
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/name",
                "control": "text"
              },
              {
                "path": "/timing",
                "control": "timing",
                "title": "When"
              },
              {
                "path": "/owner",
                "control": "reference",
                "title": "Owner"
              },
              {
                "path": "/deliverables",
                "control": "references",
                "title": "Marks"
              },
              {
                "path": "/evidence",
                "control": "sentence",
                "title": "Evidence"
              },
              {
                "path": "/waitsOn",
                "control": "list",
                "title": "Also waits on"
              }
            ]
          },
          {
            "path": "/spec/timeline/start",
            "control": "date",
            "title": "Starts",
            "checks": [
              "timeline-start-phases"
            ]
          },
          {
            "path": "/spec/timeline/phases",
            "control": "list",
            "key": "id",
            "checks": [
              "timeline-start-phases"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/name",
                "control": "text",
                "title": "Phase"
              },
              {
                "path": "/months",
                "control": "number",
                "title": "Months"
              }
            ]
          }
        ]
      },
      {
        "key": "data",
        "title": "Data",
        "guide": "The data this project uses, the data it creates, and where that data is stored.",
        "fields": [
          {
            "path": "/spec/data/consumes",
            "control": "list",
            "key": "source",
            "title": "Data used",
            "checks": [
              "data-handoff"
            ],
            "fields": [
              {
                "path": "/source",
                "control": "reference"
              },
              {
                "path": "/purpose",
                "control": "sentence"
              },
              {
                "path": "/handoff",
                "control": "choice",
                "title": "Transfer method",
                "checks": [
                  "data-handoff"
                ]
              },
              {
                "path": "/personalData",
                "control": "choice"
              }
            ]
          },
          {
            "path": "/spec/data/produces",
            "control": "list",
            "key": "sink",
            "title": "Data produced",
            "checks": [
              "data-personal-data",
              "data-sink",
              "data-capture-decided"
            ],
            "fields": [
              {
                "path": "/output",
                "control": "choice"
              },
              {
                "path": "/sink",
                "control": "reference",
                "title": "Data store",
                "checks": [
                  "data-sink"
                ]
              },
              {
                "path": "/purpose",
                "control": "sentence"
              },
              {
                "path": "/refresh",
                "control": "choice",
                "title": "Frequency"
              },
              {
                "path": "/personalData",
                "control": "choice",
                "checks": [
                  "data-personal-data"
                ]
              }
            ]
          }
        ]
      },
      {
        "key": "risks",
        "title": "Risks",
        "guide": "What could go wrong, what already has, what the work waits on, and what limits it.",
        "fields": [
          {
            "path": "/spec/risks",
            "control": "list",
            "key": "id",
            "checks": [
              "risks-mitigation",
              "risks-owned",
              "risks-escalated",
              "risks-dependency-edges",
              "risks-dependency-cycle",
              "risks-dependency-schedule"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/type",
                "control": "choice"
              },
              {
                "path": "/description",
                "control": "sentence"
              },
              {
                "path": "/impact",
                "control": "choice"
              },
              {
                "path": "/likelihood",
                "control": "choice"
              },
              {
                "path": "/mitigation",
                "control": "sentence",
                "checks": [
                  "risks-mitigation"
                ]
              },
              {
                "path": "/owner",
                "control": "reference",
                "title": "Owned by",
                "hint": "The role that manages it day to day.",
                "checks": [
                  "risks-owned"
                ]
              },
              {
                "path": "/depends/direction",
                "control": "choice",
                "when": {
                  "path": "/type",
                  "in": [
                    "dependency"
                  ]
                },
                "checks": [
                  "risks-dependency-edges"
                ]
              },
              {
                "path": "/depends/on",
                "control": "reference",
                "title": "The other end",
                "when": {
                  "path": "/type",
                  "in": [
                    "dependency"
                  ]
                },
                "checks": [
                  "risks-dependency-edges",
                  "risks-dependency-cycle"
                ]
              },
              {
                "path": "/depends/needBy",
                "control": "reference",
                "title": "Needed by",
                "when": {
                  "path": "/type",
                  "in": [
                    "dependency"
                  ]
                },
                "checks": [
                  "risks-dependency-schedule"
                ]
              },
              {
                "path": "/escalate/flag",
                "control": "toggle",
                "title": "Needs a decision above the project",
                "checks": [
                  "risks-escalated"
                ]
              },
              {
                "path": "/escalate/to",
                "control": "reference",
                "title": "Decision needed from"
              },
              {
                "path": "/escalate/reason",
                "control": "sentence",
                "title": "Decision needed"
              }
            ]
          }
        ]
      },
      {
        "key": "success",
        "title": "Success criteria",
        "guide": "What has to be true for the project to count as a success.",
        "fields": [
          {
            "path": "/spec/successCriteria",
            "control": "list",
            "key": "id",
            "checks": [
              "success-criteria",
              "success-measured",
              "success-owner",
              "landing-criteria"
            ],
            "fields": [
              {
                "path": "/id",
                "control": "readonly"
              },
              {
                "path": "/statement",
                "control": "sentence",
                "title": "Criterion",
                "hint": "Something that will be true when the project succeeds and that can be checked."
              },
              {
                "path": "/metric",
                "control": "choice",
                "title": "Type"
              },
              {
                "path": "/standard",
                "control": "text",
                "title": "Target"
              },
              {
                "path": "/source",
                "control": "reference",
                "title": "Read from",
                "checks": [
                  "data-capture-decided"
                ]
              },
              {
                "path": "/cycle",
                "control": "reference",
                "title": "Read each"
              },
              {
                "path": "/owner",
                "control": "reference",
                "title": "Measured by",
                "checks": [
                  "success-owner"
                ]
              },
              {
                "path": "/confirmedBy",
                "control": "reference",
                "title": "Signed off by"
              },
              {
                "path": "/from",
                "control": "references",
                "title": "Deliverables",
                "hint": "Only if a deliverable produces it."
              },
              {
                "path": "/assumes",
                "control": "references",
                "title": "Assumptions"
              },
              {
                "path": "/when",
                "control": "choice",
                "title": "Assessed",
                "checks": [
                  "landing-criteria"
                ]
              }
            ]
          }
        ]
      },
      {
        "key": "landing",
        "title": "Handover",
