{
  "apiVersion": "cartograph/v1",
  "kind": "Flow",
  "metadata": {
    "id": "segment",
    "name": "Segment"
  },
  "spec": {
    "for": "Segment",
    "steps": [
      {
        "key": "definition",
        "title": "Definition",
        "guide": "Which dimension this slice belongs to, what it is called, and what falls inside it.",
        "fields": [
          {
            "path": "/spec/parent",
            "control": "reference",
            "hint": "The dimension this is a value of, such as Region for the northern region. Leave empty for a dimension."
          },
          {
            "path": "/metadata/name",
            "control": "text"
          },
          {
            "path": "/spec/description",
            "control": "sentence",
            "hint": "What belongs in this and what does not."
          }
        ],
        "links": [
          {
            "kind": "Gap",
            "path": "/spec/segments",
            "check": "gap-segments",
            "needs": "holder",
            "phase": "align"
          },
          {
            "kind": "KPI",
            "path": "/spec/disaggregations"
          }
        ]
      }
    ],
    "review": true
  }
}
