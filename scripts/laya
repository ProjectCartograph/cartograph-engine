#!/usr/bin/env bash
# Run the Laya sidecar (deploy/laya, docs/adr/0023): the flake's package,
# its packages from the lockfile and the model pinned to one commit of
# its repository, all in the Nix store. Nothing is installed or fetched
# at run time, and no cache outside the store is read.
#
#   LAYA_PORT, LAYA_HOST  where it listens (8411, 127.0.0.1)
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
exec nix run "$root#laya"
