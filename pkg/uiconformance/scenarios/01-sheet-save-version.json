{
  "key": "sheet-save-version",
  "name": "A directory entry is defined and saved as a version",
  "rule": "Ids are generated by the server, never typed; a version records what was written",
  "steps": [
    { "open": { "Kind": "Team", "ID": "" } },
    { "set": { "Field": "/metadata/name", "Value": "Depot network" } },
    { "set": { "Field": "/spec/name", "Value": "Depot network" } },
    { "set": { "Field": "/spec/description", "Value": "Runs the depots." } },
    { "act": { "Action": "saveVersion", "Reason": "first definition" } },
    { "expect": { "noProblems": true } },
    { "expect": { "current": { "field": "/spec/description", "value": "Runs the depots.", "version": 1 } } },
    { "expect": { "idIsIdentifier": true } }
  ]
}
